{
	"name": "svelte-lightbox",
	"version": "1.1.8",
	"license": "MIT",
	"author": {
		"name": "Filip Holčík",
		"email": "filip.holcik.official@gmail.com"
	},
	"repository": "https://github.com/Hejtmus/svelte-lightbox.git",
	"homepage": "https://svelte-lightbox.js.org",
	"description": "Lightweight lightbox library for Svelte",
	"import": "./dist/index.js",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"directory": "dist"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"svelte": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint ./src",
		"package": "svelte-package",
		"version:patch": "npm version patch --no-git-tag-version",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version",
		"version:prerelease": "npm version prerelease --preid=alpha --no-git-tag-version"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/site-kit": "^2.1.4",
		"@sveltejs/svelte-repl": "^0.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/marked": "^4.0.8",
		"@vercel/speed-insights": "^1.1.0",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^3.23.0",
		"marked": "^4.2.12",
		"neostandard": "^0.13.0",
		"svelte": "^5.2.9",
		"svelte-preprocess": "^6.0.1",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2",
		"vite": "^8.2.1"
	},
	"peerDependencies": {
		"svelte": "^3.25.0 || ^4.0.0 || ^5.0.0"
	},
	"overrides": {
		"cookie": "^0.7.2"
	},
	"keywords": [
		"svelte",
		"svelteKit",
		"lightbox",
		"image",
		"photo",
		"video",
		"gallery",
		"ssr",
		"modal"
	],
	"type": "module"
}
